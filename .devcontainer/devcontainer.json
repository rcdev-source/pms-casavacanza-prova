{
  "name": "PMS Casa Vacanze Preview",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "PMS Casa Vacanze",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "API Laravel",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "remoteUser": "vscode"
}
